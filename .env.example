# Configure these values in the cloud platform; do not commit actual secrets.
DJANGO_SETTINGS_MODULE=config.settings_cloud
DJANGO_SECRET_KEY=
DATABASE_URL=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY=1
DJANGO_HTTPS=1
DB_SSLMODE=require
INITIALIZE_DEMO=1
DEMO_INITIAL_PASSWORD=
