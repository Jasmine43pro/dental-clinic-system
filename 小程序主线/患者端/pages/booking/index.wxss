page { background: #f5f1e8; color: #183f36; }
.page { padding: 32rpx; }
.title { font-size: 42rpx; font-weight: 600; margin-bottom: 24rpx; }
.heading { font-size: 34rpx; font-weight: 600; margin-bottom: 20rpx; }
.card { padding: 28rpx; margin-bottom: 20rpx; border: 1px solid #d3ddd5; border-radius: 16rpx; background: #fff; }
.field { display: block; margin-bottom: 20rpx; }
.field input, .field textarea, .filter { box-sizing: border-box; width: 100%; margin-top: 12rpx; padding: 16rpx; border: 1px solid #c9d6cd; border-radius: 10rpx; }
.field input { min-height: 72rpx; }
.field textarea { height: 144rpx; }
.primary { color: #fff; background: #183f36; margin-top: 24rpx; }
.secondary, .sign-out { margin: 16rpx 16rpx 12rpx 0; color: #183f36; background: #e7eee8; }
.error { padding: 18rpx; margin-bottom: 20rpx; border-radius: 10rpx; background: #fcece5; color: #7d3221; }
.slot { display: flex; gap: 16rpx; align-items: center; padding: 20rpx 0; border-top: 1px solid #e5ebe4; }
.hint { color: #52665e; font-size: 26rpx; }
.result { margin-bottom: 12rpx; overflow-wrap: anywhere; }
.result-link { padding: 16rpx; border-radius: 10rpx; text-align: center; }
